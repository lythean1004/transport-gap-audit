<script type="text/javascript" language="JavaScript"> 
//<![CDATA[
// 간단한 댓글처리
function commentSubmit(f){

	
		showConfirm(document.comment.rtUrl.value);
		return false; 
		
	 
	
 	if(!isNotNull(f.uname,"글쓴이 이름을 입력하세요")) return false;
	//if(f.c_passwd && !isNotNull(f.c_passwd,"댓글삭제에 필요한 비밀번호를 입력하세요")) return false;
	if(!isNotNull(f.content,"댓글 내용을 입력하세요")) return false; return true;
	

	
}

function showConfirm(_url, _msg){
	if( _msg==null) _msg = '본인확인 후, 글 등록이 가능합니다.\n본인확인 서비스로 이동하시겠습니까?';
	if(confirm(_msg)){
		location.href='/USR/LOGN/FRM.jsp?flag=2&rtUrl='+_url; 
	}
}

function showScrapConfirm(_url){
	if(confirm('본인확인 후, 글 등록이 가능합니다.\n본인확인 서비스로 이동하시겠습니까?')){
	 	location.href='/USR/LOGN/FRM.jsp?flag=1&rtUrl='+_url;
	}
}


// 비밀번호 입력창
function showPassForm(e, mode, action, idx) {
	if(mode == "delete") {
		if(!confirm("삭제하시겠습니까?")){
			return;
		}
	}
	
	document.passForm.mode.value=mode;
	document.passForm.actiontype.value=action;
	document.passForm.idx.value=idx;
	document.passForm.chk_data.value=idx;
	document.passForm.submit();
}

/*
// 비밀번호 입력창
function showPassForm(e, mode, action, idx) {
	xOffset= (action=="comment") ? -280 : 10; yOffset=0;

