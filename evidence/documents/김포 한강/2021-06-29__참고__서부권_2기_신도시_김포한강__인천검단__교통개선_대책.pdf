	// https > http 처리
	/*
	if ( ( $(location).attr("href").indexOf('USR/NEWS/m_71/dtl.jsp' ) > 0 ) || ( $(location).attr("href").indexOf('USR/NEWS/m_72/dtl.jsp' ) > 0 ) || ( $(location).attr("href").indexOf('USR/law/m_46/dtl.jsp' ) > 0 ) || ( $(location).attr("href").indexOf('USR/BORD0201/m_34879/DTL.jsp' ) > 0 ) || ( $(location).attr("href").indexOf('USR/BORD0201/m_34722/DTL.jsp' ) > 0 ) || ( $(location).attr("href").indexOf('USR/I0204/m_45/dtl.jsp' ) > 0 ) || ( $(location).attr("href").indexOf('USR/WPGE0201/m_36367/DTL.jsp' ) > 0 )  || ( $(location).attr("href").indexOf('USR/policyData/m_34681/dtl.jsp' ) > 0 )  || ( $(location).attr("href").indexOf('USR/budget/m_90/lst.jsp' ) > 0 )  || ( $(location).attr("href").indexOf('USR/cmit/m_1146/dtl.jsp' ) > 0 ) ) {
		//alert($(location).attr("href"));
		if (window.location.protocol != "http:") {
		    window.location.href = "http:" + window.location.href.substring(window.location.protocol.length);
		}
	} */
	$(document).ready(function(){
		
		
		var $chilrens = $('.file').children('span');
		for (var i = 0 ; i < $chilrens.length ; i++) {
			
			
			$chilrens.eq(i).children('a').children('img').removeAttr('width');
			$chilrens.eq(i).children('a').children('img').removeAttr('height');
			
			var htm2 = $chilrens.eq(i).children('.attach_viewer').html();
			$chilrens.eq(i).children('.attach_viewer').remove();
			
			
			var htm3 = $chilrens.eq(i).children('a').children('img').attr('src');
			if(htm3 == null){
			    htm3 = $chilrens.eq(i).children('a').children('i').children('img').attr('src');
			}
			htm3 = htm3.replace("/dev/board/images/", "/images/www2019/board/");
			$chilrens.eq(i).children('a').children('img').remove();
			
			var tmpAlt = 'alt="첨부문서"' ;
			if (htm3.indexOf('hwp')>0) tmpAlt = 'alt="hwp"' ;
			if (htm3.indexOf('pdf')>0) tmpAlt = 'alt="pdf"' ;
			if (htm3.indexOf('xls')>0) tmpAlt = 'alt="xls"' ;
			
			$chilrens.eq(i).children('a').append(
				'<i><img src="' + htm3 + '" '+ tmpAlt +' /></i>'
			);

			var htm = $chilrens.eq(i).html();
		
			htm = htm.replace("/dev/board/images/", "/images/www2019/board/");
			
			if (typeof htm2 == "undefined" || htm2 == null || htm2 == "")
				htm = htm ;
			else 
				htm = htm + htm2 ;
			
			
			$chilrens.eq(i).html(htm);
		
			$chilrens.eq(i).children('a').eq(1).addClass("icon_docu");
			$chilrens.eq(i).children('a').eq(1).children('img').remove();
			$chilrens.eq(i).children('a').eq(1).text("바로보기");
		}
		
		$chilrens = $('.bd_pagination').children('li');
		var tmpPageStr = "";
		//alert($chilrens.length);
		
		
		for (var i = 0 ; i < $chilrens.length ; i++) {
			
			var tmpHref ;
			if ( $chilrens.eq(i).children('a').attr("href") ) {
				tmpHref = $chilrens.eq(i).children('a').attr("href") ;
			} else {
				tmpHref = "#" ;
			}
			
			
			if (i==0) {
				tmpPageStr += "<a href='" + tmpHref + "' class='direction first'>처음으로</a>";
			} else if (i==1) {
				tmpPageStr += "<a href='" + tmpHref + "' class='direction prev'>이전페이지</a>";
			} else if (i == ($chilrens.length-2) ) {
				tmpPageStr += "<a href='" + tmpHref + "' class='direction next'>다음페이지</a>";
			} else if (i == ($chilrens.length-1) ) {
				tmpPageStr += "<a href='" + tmpHref + "' class='direction last'>마지막으로</a>";
			} else {
			
				if ( $chilrens.eq(i).attr("class")=="select" ) {
					tmpPageStr += "<strong>"+$chilrens.eq(i).children('a').text()+"</strong>";
				} else {
			
					if ( $chilrens.eq(i).children('a').attr("href") ) {
						//tmpPageStr += "<a href='" + $chilrens.eq(i).children('a').attr("href") + "'>"+(i-1)+"</a>";
						tmpPageStr += "<a href='" + $chilrens.eq(i).children('a').attr("href") + "'>"+$chilrens.eq(i).children('a').text()+"</a>";
					} else {
						//tmpPageStr += "<strong>"+(i-1)+"</strong>";
						tmpPageStr += $chilrens.eq(i).children('span').html() ;
					}
				}
			}
			if ( i == ($chilrens.length-1) ) {
				$('.bd_pagination').html(tmpPageStr);
			}
		}

	});
	//]]>
	</script>	
</head>
